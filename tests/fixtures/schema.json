{
  "mappings": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          1
        ]
      },
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "enabled": {
              "type": "boolean"
            },
            "physical_chord": {
              "type": "string",
              "pattern": "^(LWin|LAlt)(\\+Shift)?\\+([a-z]|Left|Right|Up|Down|Backspace|Tab|\\[|\\])$"
            },
            "contexts": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "edit",
                  "text",
                  "browser",
                  "explorer",
                  "vscode",
                  "terminal"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "action": {
              "type": "string",
              "enum": [
                "copy",
                "paste",
                "cut",
                "select_all",
                "undo",
                "redo",
                "save",
                "find",
                "word_left",
                "word_right",
                "select_word_left",
                "select_word_right",
                "delete_word",
                "line_start",
                "line_end",
                "document_start",
                "document_end",
                "app_next",
                "app_previous",
                "browser_address",
                "browser_new",
                "browser_close",
                "browser_reload",
                "browser_restore",
                "browser_back",
                "browser_forward",
                "explorer_new",
                "explorer_delete",
                "terminal_copy",
                "terminal_paste"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "on_unmatched": {
              "type": "string",
              "enum": [
                "passthrough"
              ]
            },
            "blocked_reason": {
              "type": "string",
              "pattern": "^[^\\r\\n\\u0000]*$"
            }
          },
          "required": [
            "id",
            "enabled",
            "physical_chord",
            "contexts",
            "action",
            "priority",
            "on_unmatched",
            "blocked_reason"
          ],
          "additionalProperties": false
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "required": [
      "schema_version",
      "mappings"
    ],
    "additionalProperties": false
  },
